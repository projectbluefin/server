{
  "ignition": {
    "version": "3.6.0"
  },
  "storage": {
    "files": [
      {
        "path": "/etc/dogfood-ignition-marker",
        "mode": 420,
        "overwrite": true,
        "contents": {
          "source": "data:,applied%0A"
        }
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "name": "dogfood-ignition-marker.service",
        "enabled": true,
        "contents": "[Unit]\nDescription=Dogfood check that Ignition enabled this unit\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/bin/touch /run/dogfood-ignition-marker\n\n[Install]\nWantedBy=multi-user.target\n"
      }
    ]
  }
}
