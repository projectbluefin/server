# Appended by dogfood-installer.sh only for DOGFOOD_PROFILE=home-server.
# The base image seeds Homebrew; the profile adds no Homebrew machinery.
set -euo pipefail
home_fail() { echo "PROBE home-server=FAIL $*"; exit 1; }
[ -f /usr/share/homebrew/brew.tar.zst ] || home_fail 'seed archive missing'
[ "$(readlink /home/linuxbrew)" = /var/home/linuxbrew ] || home_fail '/home/linuxbrew is not linked to /var/home/linuxbrew'
systemctl is-enabled --quiet bluefin-homebrew-seed.service || home_fail 'seed unit not enabled'
if getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { found = 1 } END { exit !found }'; then
    systemctl start bluefin-homebrew-seed.service || home_fail 'seed unit failed'
    [ -x /home/linuxbrew/.linuxbrew/bin/brew ] || home_fail 'brew not seeded'
    /home/linuxbrew/.linuxbrew/bin/brew --version >/dev/null || home_fail 'brew --version'
fi
echo 'PROBE home-server=PASS'
