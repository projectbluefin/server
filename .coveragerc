# Coverage measurement for the repo's Python (just test-unit, CI unit job).
# Sources are the CI scripts plus the Python shipped under files/ (e.g.
# files/homebrew-image/compose-profile.py); the tests load most of them by
# path with importlib exec_module, so the file paths, not importable module
# names, drive the source list.
[run]
source =
    scripts
    .github/scripts
    files
branch = true
# Python the tests launch as a subprocess (sys.executable, script.py) is
# measured too: coverage's subprocess patch (7.10+) starts coverage in every
# child Python whose environment keeps COVERAGE_PROCESS_CONFIG (a child given
# a fresh env= dict is not measured). It implies parallel data files, which
# pytest-cov combines with the xdist workers' data before reporting. See
# docs/skills/ci-tooling.md, "Python lint".
patch = subprocess
[report]
# A ratchet, enforced by pytest --cov and `coverage report`: the measured
# total rounded down. Raise it when coverage grows; never lower it to pass.
fail_under = 84
skip_covered = true
show_missing = true
exclude_also =
    ^\s*if __name__ == ['"]__main__['"]:?$
