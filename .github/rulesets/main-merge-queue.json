{
  "name": "main — merge queue",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "merge_queue",
      "parameters": {
        "merge_method": "SQUASH",
        "grouping_strategy": "ALLGREEN",
        "max_entries_to_build": 3,
        "min_entries_to_merge": 1,
        "max_entries_to_merge": 5,
        "min_entries_to_merge_wait_minutes": 0,
        "check_response_timeout_minutes": 360
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {"context": "changes", "integration_id": 15368},
          {"context": "validate", "integration_id": 15368},
          {"context": "boot-test-preflight", "integration_id": 15368},
          {"context": "build", "integration_id": 15368},
          {"context": "boot-test-result", "integration_id": 15368},
          {"context": "image-check", "integration_id": 15368},
          {"context": "release-dry-run", "integration_id": 15368},
          {"context": "unit", "integration_id": 15368},
          {"context": "go (files/homelab/cluster)", "integration_id": 15368},
          {"context": "docs", "integration_id": 15368},
          {"context": "actionlint", "integration_id": 15368},
          {"context": "zizmor", "integration_id": 15368}
        ]
      }
    }
  ]
}
