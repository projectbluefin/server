{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["main"],
  "branchPrefix": "renovate/",
  "schedule": ["every monday between 00:00 and 03:00"],
  "rebaseWhen": "never",

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^elements/.*\\.bst$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n\\s*ref:\\s*['\"]?(?<currentValue>[^'\"\\s]+)['\"]?"
      ]
    }
  ],

  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "pinDigests": true
    },
    {
      "automerge": true,
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchDatasources": ["git-refs"],
      "matchPackageNames": ["https://gitlab.com/freedesktop-sdk/freedesktop-sdk.git"],
      "extractVersion": "^freedesktop-sdk-(?<version>26\\.08\\.[0-9]+)$",
      "versioning": "semver"
    }
  ]
}
