[Unit]
Description=Load the ZFS kernel modules
Documentation=man:zfs(8)
DefaultDependencies=no
After=systemd-sysext.service systemd-udev-trigger.service
Before=zfs-import.target zfs-import-cache.service zfs-import-scan.service
Before=zfs-mount.service zfs-volume-wait.service zfs-zed.service
ConditionPathIsDirectory=!/sys/module/zfs

[Service]
Type=oneshot
RemainAfterExit=yes
# The sysext ships no module index; the base image's helper indexes the merged
# module tree under /run and loads zfs (and spl) from it. A bare `modprobe zfs`
# does not find the module, so libzfs, which only runs modprobe when /dev/zfs
# is missing, relies on this unit having loaded it.
ExecStart=/usr/libexec/bluefin-sysext-modules zfs

[Install]
WantedBy=zfs.target
