# namespace name key=value... ; @file:<path> reads an operator file (the
# component is skipped while it is missing), @optfile:<path> too but only
# leaves this Secret out while it is missing, @random generates a value
# once, @htpasswd:<user> a password once ({SHA} htpasswd line in this key,
# the password in "password").
# Optional GitHub OAuth app (callback https://kubestellar.<HOMELAB_DOMAIN>/auth/github/callback):
# its client id and secret, each written without a trailing newline (printf %s).
kubestellar-console kubestellar-console-github-oauth github-client-id=@optfile:/etc/bluefin/homelab.d/kubestellar-console/github-client-id github-client-secret=@optfile:/etc/bluefin/homelab.d/kubestellar-console/github-client-secret
kubestellar-console kubestellar-console-jwt jwt-secret=@random
kubestellar-console kubestellar-console-bootstrap bootstrap-token=@random
# The Gateway's login password in front of the Console's sign-in (11-login-gate.yaml).
kubestellar-console kubestellar-console-login .htpasswd=@htpasswd:admin
