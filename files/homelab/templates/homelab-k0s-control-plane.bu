# Bluefin Server: Homelab — k0s control plane (the alternative to kubeadm).
#
# Pass this file as the node's Ignition config (the ignition.config system
# credential; Ignition reads Butane YAML as is) or compile it first with
# `butane --strict`; homelab-k0s-control-plane.ign is the compiled copy. On
# the first boot the node pulls in the k0s sysext (k0s-first-boot.service,
# the k0s sysupdate component) and the homelab sysext
# (bluefin-sysext-fetch.service, through the homelab sysupdate feature), starts
# a k0s controller that also runs workloads and applies the default homelab
# components (k0s brings its own CNI, so no Cilium) and the add-ons
# (argo-workflows, mcp and kubestellar features). Nodes join with
# homelab-k0s-node.bu and the join passphrase this node shows on its console.
# Reference:
# https://github.com/projectbluefin/server/blob/main/docs/skills/homelab-profile.md
#
# Edit before use: your SSH public key below, and the optional settings in
# homelab.conf (MetalLB address pool, ACME email, Argo CD root repository,
# NFS, democratic-csi, GPU, monitoring, add-ons: domain, MCP read-write,
# KubeStellar Console GitHub sign-in).
variant: fcos
version: 1.7.0
passwd:
  users:
    - name: root
      ssh_authorized_keys:
        # Replace this line with your SSH public key (sshd allows root with a
        # key only). As root: kubectl, crictl, `bluefin-cluster passphrase`.
        - "# REPLACE with your SSH public key, e.g. ssh-ed25519 AAAA... you@example.com"
systemd:
  units:
    # sshd is off by default (80-bluefin-sshd.preset).
    - name: sshd.service
      enabled: true
    - name: bluefin-sysext-fetch.service
      enabled: true
    - name: k0s-first-boot.service
      enabled: true
storage:
  files:
    - path: /etc/sysupdate.d/homelab.feature.d/50-homelab.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Feature]
          Enabled=true
    # The homelab add-ons, applied after the default components: Argo
    # Workflows, the Kubernetes MCP server and the KubeStellar Console.
    - path: /etc/sysupdate.d/argo-workflows.feature.d/50-homelab.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Feature]
          Enabled=true
    - path: /etc/sysupdate.d/mcp.feature.d/50-homelab.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Feature]
          Enabled=true
    - path: /etc/sysupdate.d/kubestellar.feature.d/50-homelab.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Feature]
          Enabled=true
    # A controller that also runs workloads and that nodes can join (the k0s
    # sysext's default is --single).
    - path: /etc/sysconfig/k0s
      mode: 0644
      overwrite: true
      contents:
        inline: |
          K0S_CONTROLLER_ARGS=--enable-worker --no-taints --disable-components=helm,autopilot
    # homelab.conf is created from this copy once (tmpfiles C: only while it
    # is absent), so on an installed node later edits to
    # /etc/bluefin/homelab.conf stay; Ignition applies this config on every
    # boot that carries it.
    - path: /etc/tmpfiles.d/50-bluefin-homelab.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          C /etc/bluefin/homelab.conf - - - - /etc/bluefin/homelab.conf.template
    - path: /etc/bluefin/homelab.conf.template
      mode: 0600
      overwrite: true
      contents:
        inline: |
          # /etc/bluefin/homelab.conf — read by bluefin-homelab-apply.service and
          # bluefin-cluster (systemd EnvironmentFile syntax: KEY=value, no shell
          # expansion).
          #
          # Multi-node: HOMELAB_ROLE=control-plane on one node, HOMELAB_ROLE=node on
          # the others (unset: a single-node homelab). The control plane advertises
          # itself over mDNS and generates a join passphrase at first start (console
          # and `bluefin-cluster passphrase`); a node needs only that passphrase, which
          # it deletes from this file once joined. Components are applied by the
          # control plane only.
          HOMELAB_ROLE=control-plane
          #HOMELAB_ROLE=node
          #HOMELAB_JOIN_PASSPHRASE=four-words-from-the-console
          # Node: skip mDNS discovery and use this control plane (host[:port]).
          #HOMELAB_CONTROL_PLANE=cp1.local
          # Control plane: name shown in the mDNS advertisement (default: hostname),
          # and the join service port.
          #HOMELAB_CLUSTER_NAME=homelab
          #HOMELAB_JOIN_PORT=6447
          #
          # Components: HOMELAB_<ID>=yes|no overrides the default listed in
          # /usr/share/bluefin/homelab/components. On by default: CILIUM (kubeadm only),
          # LOCAL_PATH_PROVISIONER, METALLB, ENVOY_GATEWAY, CERT_MANAGER, ARGOCD,
          # METRICS_SERVER (kubeadm only), RELOADER, KURED. Off by default: NFS,
          # DEMOCRATIC_CSI, GPU_OPERATOR and monitoring (KUBE_PROMETHEUS_STACK, LOKI,
          # ALLOY; enable all three together).
          #
          # Add-ons (their own sysexts, applied after the components when merged):
          # HOMELAB_<ID>=yes|no overrides the default in
          # /usr/share/bluefin/homelab/addons.d/<NN-id>/addon. On by default:
          # ARGO_WORKFLOWS, MCP, KUBESTELLAR_CONSOLE. Off by default: KUBESTELLAR_FULL.

          # MetalLB L2 address pool: free LAN addresses outside your DHCP range (ranges
          # or CIDRs, comma separated). Required for LoadBalancer Services.
          #HOMELAB_METALLB_ADDRESSES=192.0.2.240-192.0.2.250

          # cert-manager: an ACME (Let's Encrypt) ClusterIssuer "acme" is added when an
          # email is set; the "selfsigned" ClusterIssuer is always there. With an
          # ACME email, the homelab Gateway's HTTPS listener gets a Let's Encrypt
          # wildcard cert for *.<HOMELAB_DOMAIN> (HTTP-01 through the same Gateway,
          # so the names must resolve to it from the ACME server); without one, the
          # same listener terminates with a self-signed cert LAN devices have to
          # trust out of band.
          #HOMELAB_ACME_EMAIL=you@example.com
          #HOMELAB_ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

          # Argo CD: an app-of-apps root Application "homelab-root".
          #HOMELAB_ARGOCD_ROOT_REPO=https://example.com/you/homelab.git
          #HOMELAB_ARGOCD_ROOT_REVISION=HEAD
          #HOMELAB_ARGOCD_ROOT_PATH=apps

          # kured reboot window (defaults: any day, all day, UTC).
          #HOMELAB_KURED_TIME_ZONE=UTC
          #HOMELAB_KURED_START_TIME=0:00
          #HOMELAB_KURED_END_TIME=23:59:59
          #HOMELAB_KURED_REBOOT_DAYS=su,mo,tu,we,th,fr,sa

          # NFS client provisioner (StorageClass "nfs-client").
          #HOMELAB_NFS=yes
          #HOMELAB_NFS_SERVER=nas.example.com
          #HOMELAB_NFS_PATH=/export/k8s

          # democratic-csi iSCSI (StorageClass "democratic-csi-iscsi"): its driver
          # config, including the NAS SSH key, goes in
          # /etc/bluefin/homelab.d/democratic-csi/driver-config-file.yaml (mode 0600).
          #HOMELAB_DEMOCRATIC_CSI=yes

          # NVIDIA GPU Operator: needs the nvidia-open-* and nvidia-container-toolkit
          # sysexts on the node.
          #HOMELAB_GPU_OPERATOR=yes

          # Monitoring: Prometheus/Alertmanager/Grafana, Loki and Alloy (pod + journal logs).
          #HOMELAB_KUBE_PROMETHEUS_STACK=yes
          #HOMELAB_LOKI=yes
          #HOMELAB_ALLOY=yes

          # Add-ons are exposed on the homelab Gateway by host name:
          # argo.<domain>, mcp.<domain>, kubestellar.<domain>. The Gateway listens on
          # HTTP port 80 (kept for cert-manager HTTP-01) and HTTPS port 443 terminated
          # with a wildcard cert for *.<HOMELAB_DOMAIN> issued by cert-manager
          # (selfsigned when no ACME email is set, Let's Encrypt when
          # HOMELAB_ACME_EMAIL is and the names resolve to the Gateway's MetalLB
          # address from the ACME server). Point those names (or a wildcard) at the
          # Gateway's address.
          #HOMELAB_DOMAIN=home.arpa

          # Argo Workflows (argo sysext): the server takes a Kubernetes token
          # (--auth-mode=client), e.g. `kubectl -n argo create token argo-server`.
          #HOMELAB_ARGO_WORKFLOWS=no

          # Kubernetes MCP server (mcp sysext): read-only; clients authenticate with
          # the mcp-client token (`kubectl -n mcp get secret mcp-client-token -o
          # jsonpath='{.data.token}' | base64 -d`). yes: write tools too, and
          # mcp-client gets the "edit" ClusterRole.
          #HOMELAB_MCP_READ_WRITE=yes

          # KubeStellar Console (kubestellar sysext) at https://kubestellar.<domain>:
          # its sign-in asks for the login password (user admin; shown on the
          # console, or `kubectl -n kubestellar-console get secret
          # kubestellar-console-login -o jsonpath='{.data.password}' | base64 -d`),
          # then signs in as the Console's built-in admin. GitHub sign-in instead (the
          # password prompt stays in front of it): a GitHub OAuth app (callback
          # https://kubestellar.<domain>/auth/github/callback) with its client id and
          # secret, each without a trailing newline, in
          # /etc/bluefin/homelab.d/kubestellar-console/github-client-id and
          # /etc/bluefin/homelab.d/kubestellar-console/github-client-secret (mode
          # 0600), and the GitHub logins allowed to sign in (any GitHub account
          # without; comma separated) and those made admins:
          #HOMELAB_KUBESTELLAR_CONSOLE_ALLOWED_LOGINS=you,friend
          #HOMELAB_KUBESTELLAR_CONSOLE_ADMIN_LOGINS=you
          # Full KubeStellar (KubeFlex, Postgres, the KubeStellar controllers):
          #HOMELAB_KUBESTELLAR_FULL=yes

