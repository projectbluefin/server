[Unit]
Description=Refuse more than one merged NVIDIA driver flavour
Documentation=man:systemd-sysext(8)
DefaultDependencies=no
After=systemd-sysext.service
Before=nvidia-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/sh -c 'set -- /usr/lib/extension-release.d/extension-release.nvidia-open-*; [ "$$#" -eq 1 ] || { echo "more than one NVIDIA driver flavour is merged: $$*" >&2; exit 1; }; exit 0'
