[Unit]
Description=Create the NVIDIA device nodes
After=nvidia-load.service
ConditionPathIsDirectory=/sys/module/nvidia

[Service]
Type=oneshot
RemainAfterExit=yes
# The modules do not create their own /dev nodes: /dev/nvidiactl and one
# /dev/nvidiaN per GPU, then /dev/nvidia-uvm*, then /dev/nvidia-modeset.
ExecStart=/usr/bin/sh -c 'n=$$(ls /proc/driver/nvidia/gpus | wc -l); i=0; while [ "$$i" -lt "$$n" ]; do /usr/bin/nvidia-modprobe -c "$$i" || exit; i=$$((i+1)); done'
ExecStart=/usr/bin/nvidia-modprobe -u -c 0
ExecStart=-/usr/bin/nvidia-modprobe -m
# Bounded wait until the GPU's firmware accepts clients.
ExecStart=-/usr/bin/sh -c 'i=0; while [ "$$i" -lt 50 ]; do /usr/bin/nvidia-smi -L >/dev/null 2>&1 && exit 0; i=$$((i+1)); sleep 0.2; done; exit 1'
