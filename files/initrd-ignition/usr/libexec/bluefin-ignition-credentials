#!/usr/bin/bash
# bluefin-ignition-credentials — stage an Ignition config from system credentials.
#
# Bluefin Server's kernel command line is sealed into the signed UKI, so
# Ignition's ignition.config.url= karg cannot be used. Its config is taken
# from system credentials instead (SMBIOS type 11, QEMU fw_cfg, or
# /loader/credentials on the ESP), imported into $CREDENTIALS_DIRECTORY by
# ImportCredential= in bluefin-ignition-credentials.service:
#
#   ignition.config      an Ignition JSON (or, since Ignition 2.27, Butane
#                        YAML) config; copied verbatim
#   ignition.config.url  a URL (http, https, tftp, s3, gs, arn, data); wrapped
#                        in a config whose ignition.config.replace points at
#                        it, so ignition-fetch pulls the real config once the
#                        network is online
#
# If both are set, ignition.config wins and ignition.config.url is ignored.
# Credentials are as trusted as whoever set them (SMBIOS, the ESP).
#
# Without either credential, a network-booted node looks for bluefin-node.ign
# in the directory it booted from, as reported by /usr/libexec/bluefin-boot-origin:
# the UEFI HTTP boot URL (StubDeviceURL EFI variable), the same way the initrd
# derives the /usr image URL, or, for a node chainloaded by iPXE, the URL its
# boot server (Booty) passes in rd.systemd.pull. Nothing there means nothing to
# apply. If it is there, its detached signature bluefin-node.ign.gpg must
# verify against the import keyring, and the verified bytes are applied. The
# signature is the gate, not the transport, as for the /usr pull. The rules
# (and the bluefin.ignition.allow-unsigned opt-out) are in
# docs/skills/booty-integration.md.
#
# Output: /run/ignition/user.ign (absent when there is nothing to apply), the
# highest-priority user config path that Ignition's "system" provider reads
# before the platform provider.
#
# Deliberately bash builtins, coreutils, curl and gpgv only.

set -euo pipefail
export LC_ALL=C

PROG="${0##*/}"
# Output path is fixed by Ignition's contract: /run/ignition/user.ign is the
# highest-priority user config path the "system" provider reads. BLUEFIN_IGNITION_OUT
# overrides it for the unit test (same seam bluefin-boot-deadline uses for its
# reboot sentinel); it is never set in the initrd.
OUT="${BLUEFIN_IGNITION_OUT:-/run/ignition/user.ign}"
# Newest stable config spec in Ignition v2.27.0 (config/v3_6). A replaced
# config may use any spec version Ignition accepts.
STUB_VERSION=3.6.0
# A scheme, then no whitespace, control characters, '"' or '\': the value is
# pasted into a JSON string unescaped, so refuse anything that would need it.
URL_RE='^[A-Za-z][A-Za-z0-9+.-]*:[^[:space:][:cntrl:]"\]+$'

log() { printf '%s: %s\n' "${PROG}" "$*" >&2; }
die() { log "$*"; exit 1; }

# The keyring systemd-importd and sysupdate verify SHA256SUMS.gpg against: the
# /etc operator override when there is one, else the image's own
# (os-sysupdate-keys.bst). BLUEFIN_IMPORT_KEYRING overrides both for the unit
# test. The choice is final: an override that is there but cannot be read (a
# dangling symlink, say) fails verification instead of falling back to the
# image's keyring.
keyring="${BLUEFIN_IMPORT_KEYRING:-}"
if [ -z "${keyring}" ]; then
  keyring=/etc/systemd/import-pubring.pgp
  [ -e "${keyring}" ] || [ -L "${keyring}" ] || keyring=/usr/lib/systemd/import-pubring.pgp
fi
CURL=(curl --silent --show-error --retry 3 --connect-timeout 10 --max-time 30)

NODE_CONFIG=bluefin-node.ign
BOOT_ORIGIN="${BLUEFIN_BOOT_ORIGIN:-/usr/libexec/bluefin-boot-origin}"

creds="${CREDENTIALS_DIRECTORY:-/nonexistent}"
config="${creds}/ignition.config"
url_cred="${creds}/ignition.config.url"
allow_unsigned_cred="${creds}/bluefin.ignition.allow-unsigned"

# Stage the config bytes already in <file> as the inline user config.
stage_inline() { mv -f "$1" "${OUT}"; }

# Wrap a URL in a stub config whose ignition.config.replace points at it, so
# ignition-fetch pulls the real config once the network is online.
stage_url() {
  [[ "$1" =~ ${URL_RE} ]] || die "invalid Ignition config URL: $(printf '%q' "$1")"
  printf '{"ignition":{"version":"%s","config":{"replace":{"source":"%s"}}}}\n' \
    "${STUB_VERSION}" "$1" > "${OUT}.tmp"
}

# Verify <signature> over <config> with gpgv against the import keyring.
# gpgv reports to the journal which key signed, or why it refused.
verify_sig() {
  [ -f "${keyring}" ] && [ -r "${keyring}" ] \
    || die "import keyring ${keyring} is missing or unreadable; refusing to apply ${NODE_CONFIG} rather than trust another keyring"
  mkdir -m 0700 "${tmp}/gnupg"
  GNUPGHOME="${tmp}/gnupg" gpgv --keyring "${keyring}" "$1" "$2" >&2
}

umask 077
mkdir -p "${OUT%/*}"

tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT

if [ -s "${config}" ]; then
  [ ! -s "${url_cred}" ] || log "ignition.config and ignition.config.url both set; ignoring ignition.config.url"
  cp "${config}" "${OUT}.tmp"
  stage_inline "${OUT}.tmp"
  log "staged inline config from credential ignition.config"
elif [ -s "${url_cred}" ]; then
  url="$(<"${url_cred}")"
  stage_url "${url}"
  stage_inline "${OUT}.tmp"
  log "staged config.replace of ${url} (credential ignition.config.url)"
else
  # Network boot: bluefin-node.ign next to the UKI.
  if ! boot_url="$("${BOOT_ORIGIN}")"; then
    log "no Ignition credential and no network boot origin; nothing to apply"
    exit 0
  fi
  config_url="${boot_url%/*}/${NODE_CONFIG}"
  sig_url="${config_url}.gpg"
  # Nothing served next to the UKI means nothing to apply.
  if ! "${CURL[@]}" --fail --head -o /dev/null --url "${config_url}"; then
    log "no ${NODE_CONFIG} next to ${boot_url}; nothing to apply"
    exit 0
  fi
  "${CURL[@]}" --fail -o "${tmp}/${NODE_CONFIG}" --url "${config_url}"
  # A signature that cannot be fetched is not a missing one: only an HTTP 404
  # counts as unsigned. Whoever can swap the config can also withhold the .gpg.
  rc=0
  code="$("${CURL[@]}" -o "${tmp}/${NODE_CONFIG}.gpg" -w '%{http_code}' --url "${sig_url}")" || rc=$?
  [ "${rc}" -eq 0 ] || die "fetching ${sig_url} failed (curl exit ${rc}); refusing to apply ${NODE_CONFIG} unverified"
  case "${code}" in
    200)
      verify_sig "${tmp}/${NODE_CONFIG}.gpg" "${tmp}/${NODE_CONFIG}" \
        || die "${sig_url} does not verify against ${keyring}; refusing to apply ${NODE_CONFIG}"
      stage_inline "${tmp}/${NODE_CONFIG}"
      log "staged ${NODE_CONFIG} from ${config_url} (gpgv-verified against ${keyring})"
      ;;
    404)
      [ -s "${allow_unsigned_cred}" ] \
        || die "${config_url} is not signed (no ${NODE_CONFIG}.gpg) and credential bluefin.ignition.allow-unsigned is not set; refusing to apply it"
      stage_inline "${tmp}/${NODE_CONFIG}"
      log "staged ${NODE_CONFIG} from ${config_url} UNAUTHENTICATED (credential bluefin.ignition.allow-unsigned)"
      ;;
    *) die "fetching ${sig_url} returned HTTP ${code}; refusing to apply ${NODE_CONFIG} unverified" ;;
  esac
fi
