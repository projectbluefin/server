[Unit]
Description=Set the root password (first boot after a USB install)
Documentation=man:systemd-firstboot(1)
# Root ships locked ("!unprovisioned") and 10-bluefin-no-root-prompt.conf keeps
# systemd-firstboot.service from asking, so headless netboot and Booty nodes
# never wait on the console. The USB installer passes
# bluefin.prompt-root-password to the disk it installs (sysinstall
# --set-credential=), so only a machine installed from the stick, with a person
# at its console, asks for a root password on its first boot. A
# passwd.*.root credential answers it without a prompt.
ConditionPathIsReadWrite=/etc
ConditionFirstBoot=yes
ConditionCredential=bluefin.prompt-root-password
DefaultDependencies=no
After=systemd-remount-fs.service
After=systemd-sysusers.service systemd-tmpfiles-setup.service
After=systemd-vconsole-setup.service systemd-firstboot.service
After=systemd-mute-console.socket
Wants=first-boot-complete.target
Before=first-boot-complete.target sysinit.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=systemd-firstboot --prompt-root-password --mute-console=yes
# tty1, not /dev/console: the disk UKI puts console=ttyS0 last, so
# /dev/console is the serial port, while the person who ran the USB installer
# is at the monitor.
StandardOutput=tty
StandardInput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
ImportCredential=passwd.hashed-password.root
ImportCredential=passwd.plaintext-password.root

[Install]
WantedBy=sysinit.target
