[Transfer]

[Source]
Type=url-file
Path=https://github.com/projectbluefin/server/releases/latest/download/
MatchPattern=nvidia-container-toolkit-@v.raw.zst

[Target]
Type=regular-file
Path=/var/lib/nvidia-container-toolkit
