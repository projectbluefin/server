[Transfer]
Features=nvidia-open-595
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/projectbluefin/server/releases/latest/download/
MatchPattern=nvidia-open-595_@v.raw.zst

[Target]
Type=regular-file
Path=/var/lib/extensions
MatchPattern=nvidia-open-595_@v.raw
Mode=0444
InstancesMax=2
