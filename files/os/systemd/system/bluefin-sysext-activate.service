[Unit]
Description=Start units enabled by system extensions merged at boot
Documentation=man:systemd-sysext(8)
# systemd-sysext.service merges /var/lib/extensions and /etc/extensions after
# PID 1 has built the boot transaction, so [Install] symlinks shipped inside a
# sysext (e.g. zfs.target in multi-user.target.wants) are not part of it.
# Re-requesting multi-user.target adds jobs for its now-visible Wants=.
After=systemd-sysext.service
# Only when a system extension is merged into /usr.
ConditionDirectoryNotEmpty=/usr/lib/extension-release.d

[Service]
Type=oneshot
# No RemainAfterExit=: bluefin-sysext-fetch starts it again after a retry
# merged sysexts this unit's first run did not see.
ExecStart=/usr/bin/systemctl start --no-block multi-user.target

[Install]
WantedBy=multi-user.target
