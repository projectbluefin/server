[Unit]
Description=Generate persistent SSH host keys
Requires=var.mount
After=var.mount
Before=sshd.service

[Service]
Type=oneshot
StateDirectory=ssh
ExecStart=/bin/bash -eu -c 'test -s /var/lib/ssh/ssh_host_ed25519_key || /usr/bin/ssh-keygen -q -N "" -t ed25519 -f /var/lib/ssh/ssh_host_ed25519_key; test -s /var/lib/ssh/ssh_host_rsa_key || /usr/bin/ssh-keygen -q -N "" -t rsa -b 3072 -f /var/lib/ssh/ssh_host_rsa_key'
