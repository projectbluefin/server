[Unit]
Description=Seed the Bluefin cluster: CNI, Argo CD Core, manifest bridge, root Application
Documentation=file:///usr/share/bluefin/seed
# Deliberately no ConditionPathExists. A failed condition marks a unit
# *skipped* rather than failed, which would silently no-op the seed on first
# boot and leave a node with no CNI and no reconciler. Every phase below is a
# server-side apply and is idempotent on its own, so re-running is free.
# Wants=, not Requires=, on kubeadm-init.service.
#
# A job that dies with result 'dependency' never runs, so its own
# Restart=on-failure never engages and systemd never re-queues it. Under
# Requires= that made this unit permanently dead whenever kubeadm-init failed
# even once — and kubeadm-init has Restart=on-failure precisely because a first
# attempt can lose a race with the CRI socket, a slow etcd, an image pull or
# clock skew. Observed exactly that: kubeadm failed at 12:18:13, succeeded on
# retry at 12:18:59, and this unit stayed inactive forever with a control plane
# up and no CNI, no Argo and no console.
#
# With Wants= plus After=, a premature start is harmless: every phase is a
# server-side apply, the unit has Restart=on-failure/RestartSec=30s and
# TimeoutStartSec=1800, so it retries against the API server until the control
# plane answers. The chain converges instead of depending on kubeadm-init
# succeeding on the very first try.
Wants=kubeadm-init.service
After=kubeadm-init.service
# bluefin-cluster-repo.service stays a hard requirement: it is a base-OS unit
# that exists at transaction time, and without the mirrored manifests in
# /var/lib/bluefin/cluster.git there is nothing for the seed phases to apply.
Requires=bluefin-cluster-repo.service
After=bluefin-cluster-repo.service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
# TimeoutStartSec must cover every bounded step below, or systemd kills the unit
# mid-chain and the kill reads as a generic timeout instead of naming the phase
# that stalled. The budget is partitioned rather than shared:
#
#   ExecStartPre  API server probe                     600
#   phase 1       kubectl wait node Ready              300
#   phase 2       kubectl wait deployment Available    600
#   phase 2       kubectl rollout status statefulset   600
#   phase 3       kubectl wait deployment Available    600
#                                                     ----
#                                                     2700
#
# 3000 leaves headroom for the applies themselves without letting a genuinely
# stuck seed sit for an hour before Restart=on-failure gets a turn.
TimeoutStartSec=3000
Environment=KUBECONFIG=/etc/kubernetes/admin.conf
# The seed is append-only and is never pruned: kubectl's allowlist --prune is
# alpha and incompatible with --server-side, and --applyset cannot span the
# namespaces this seed touches. Argo CD owns pruning for everything downstream.
# Wait for the API server before applying anything, and say so while waiting.
#
# This is the cost of Wants= over Requires= above. Under Requires=, a broken
# kubeadm-init produced exactly one legible line — "Job ... failed with result
# 'dependency'" — which is how the stranding bug was found in the first place.
# Under Wants= this unit instead retries every 30s until TimeoutStartSec, and in
# CI the 900s readiness gate fires first, so the operator would see a timeout
# with no stated cause and many rounds of kubectl connection errors to read
# through.
#
# Probing here collapses that into one self-describing line per attempt, and it
# sharpens the signal: once this passes, the API server is answering, so any
# failure in the phases below is a genuine apply failure rather than a control
# plane that has not arrived yet. `get --raw /readyz` is the cheapest call that
# proves the apiserver is serving, and needs no RBAC beyond the admin kubeconfig.
#
# The loop is bounded at 60 attempts (600s), not open-ended. An unbounded `until`
# would share this unit's TimeoutStartSec with the apply phases and could consume
# the entire budget before phase 1 ran — the systemd kill would then be
# attributed to the seed rather than to the control plane, which is exactly the
# ambiguity this probe exists to remove. Exiting non-zero instead hands the
# failure to Restart=on-failure with a line that names the cause.
ExecStartPre=/usr/bin/bash -c 'for i in $(seq 60); do /usr/bin/kubectl --request-timeout=5s get --raw /readyz >/dev/null 2>&1 && exit 0; echo "waiting for the Kubernetes API server; kubeadm-init has not finished (attempt ${i}/60)"; sleep 10; done; echo "API server never became ready after 600s; not attempting the seed" >&2; exit 1'
# Phase 1: CNI. Nothing else can schedule until the node leaves NotReady.
ExecStart=/usr/bin/kubectl apply --server-side --force-conflicts -k /usr/share/bluefin/seed/00-cilium
ExecStart=/usr/bin/kubectl wait --for=condition=Ready node --all --timeout=300s
# Phase 2: the reconciler itself. The application controller is a StatefulSet,
# so `wait deployment --all` would not cover it.
ExecStart=/usr/bin/kubectl apply --server-side --force-conflicts -k /usr/share/bluefin/seed/10-argocd-core
ExecStart=/usr/bin/kubectl wait --for=condition=Available deployment --all --namespace argocd --timeout=600s
ExecStart=/usr/bin/kubectl rollout status statefulset/argocd-application-controller --namespace argocd --timeout=600s
# Phase 3: the git bridge that lets Argo read /var/lib/bluefin/cluster.git.
ExecStart=/usr/bin/kubectl apply --server-side --force-conflicts -k /usr/share/bluefin/seed/15-gitd
ExecStart=/usr/bin/kubectl wait --for=condition=Available deployment/bluefin-git-daemon --namespace bluefin-system --timeout=600s
# Phase 4: hand the cluster over. Argo owns everything from here.
ExecStart=/usr/bin/kubectl apply --server-side --force-conflicts -k /usr/share/bluefin/seed/20-root-app

[Install]
WantedBy=multi-user.target
