[Unit]
Description=Activate k0s sysext on boot
Wants=network-online.target
Wants=k0s-first-boot-fetch.service
After=network-online.target
After=k0s-first-boot-fetch.service
# `systemd-sysext refresh` unmerges /usr and merges it again; a module load
# unit reading /usr/lib/modules meanwhile finds nothing and fails. Let the
# ones in this boot's transaction finish first (ordering only).
After=zfs-load-module.service nvidia-load.service
RequiresMountsFor=/var/lib/k0s

[Service]
Type=oneshot
StateDirectory=k0s
Restart=on-failure
RestartSec=30s
ExecStartPre=/usr/bin/test -e /var/lib/k0s/k0s.raw
ExecStart=/usr/bin/install -D -m 0644 /var/lib/k0s/k0s.raw /run/extensions/k0s.raw
ExecStart=/usr/bin/systemd-sysext refresh
ExecStart=/usr/bin/systemctl daemon-reload
ExecStart=/usr/bin/sh -c 'if [ -s /etc/k0s/token ]; then exec systemctl enable --now k0sworker.service; else exec systemctl enable --now k0scontroller.service; fi'
[Install]
WantedBy=multi-user.target
