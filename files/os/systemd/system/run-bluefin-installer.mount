[Unit]
Description=ESP of the Bluefin Server USB installer (installer source)
Documentation=man:systemd-sysinstall(8)

[Mount]
What=/dev/disk/by-partlabel/bluefin-installer
Where=/run/bluefin/installer
Type=vfat
# fmask: vfat has no permission bits; without it every file reads as
# executable and systemd-repart warns about each repart.d definition.
Options=ro,nosuid,nodev,noexec,fmask=0133,dmask=0022
