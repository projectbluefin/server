[Unit]
Description=ESP of the running Bluefin Server image (installer source)
Documentation=man:systemd-sysinstall(8)
ConditionPathExists=/dev/disk/by-loop-ref/rootdisk.raw-part3

[Mount]
What=/dev/disk/by-loop-ref/rootdisk.raw-part3
Where=/run/bluefin/boot
Type=vfat
# fmask: vfat has no permission bits; without it every file reads as
# executable and systemd-repart warns about each repart.d definition it
# reads from /run/bluefin/boot/bluefin/repart.d. Match run-bluefin-installer.mount
# (fmask=0133,dmask=0022) so the diskless path is quiet too.
Options=ro,nosuid,nodev,noexec,fmask=0133,dmask=0022
