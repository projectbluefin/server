#!/usr/bin/bash
# bluefin-boot-deadline — reboot a boot-counted boot that was not blessed in time.
#
# systemd-sysupdate installs a new UKI with a tries counter
# (bluefin-server-<ver>+3-0.efi). systemd-boot uses up one try each time it
# boots the entry, and systemd-bless-boot drops the counter once
# boot-complete.target is reached, which systemd-boot-check-no-failures.service
# allows only when no unit failed. A boot that never gets there keeps its
# counter, but systemd-boot only moves on at the next boot, and nothing else
# reboots a node that is already running the newest installed version.
#
# bluefin-boot-deadline.timer runs this once the deadline passes (OnBootSec=,
# 15 min unless a drop-in changes it), on boot-counted boots only. If the boot
# is still not blessed:
#
#   - /run/reboot-lock or /etc/reboot-lock: the operator holds reboots (the
#     same files stop systemd-sysupdate-reboot.service); log and stay up;
#   - kubelet or k0s running: the node may carry workloads, so do what the
#     update path does and touch /run/reboot-required for kured to cordon,
#     drain and reboot it within its cluster lock;
#   - otherwise reboot, so systemd-boot uses up the next try and, after the
#     last one, falls back to the previous UKI. A Kubernetes unit that is
#     stopped or failed leaves the node NotReady with nothing to drain, and
#     kured cannot run there either, so that node reboots directly. With a
#     FleetLock server configured it first takes a reboot slot
#     (bluefin-reboot-lock acquire); when the server refuses one (or the
#     client fails otherwise) it exits 75 and bluefin-boot-deadline.service
#     runs it again later (RestartForceExitStatus=). When the server cannot
#     be reached (the client exits 3) it reboots without a slot: the update it
#     rolls back may be what broke the network, DNS or TLS, and waiting would
#     keep the node on it for good.
#     A node that rebooted for an update still holds its slot until a boot is
#     good, so its tries and the fallback get the slot straight away.
#
# The last try boots as "dirty" (no tries left). It reboots only when another
# UKI still has tries or no counter, so a node with nothing to fall back to
# does not reboot in a loop.
#
# Journal priorities come from SyslogLevelPrefix: <3> err, <4> warning,
# <6> info.
#
# Test overrides: BLUEFIN_BLESS_BOOT, BLUEFIN_BOOT_PATH, BLUEFIN_OS_RELEASE,
# BLUEFIN_REBOOT_LOCKS (space-separated), BLUEFIN_REBOOT_SENTINEL,
# BLUEFIN_REBOOT_LOCK (the FleetLock client).

set -euo pipefail
export LC_ALL=C

bless="${BLUEFIN_BLESS_BOOT:-/usr/lib/systemd/systemd-bless-boot}"
reboot_lock="${BLUEFIN_REBOOT_LOCK:-/usr/libexec/bluefin-reboot-lock}"
sentinel="${BLUEFIN_REBOOT_SENTINEL:-/run/reboot-required}"
os_release="${BLUEFIN_OS_RELEASE:-/usr/lib/os-release}"
read -r -a locks <<< "${BLUEFIN_REBOOT_LOCKS:-/run/reboot-lock /etc/reboot-lock}"

info() { printf '<6>%s\n' "$*"; }
warn() { printf '<4>%s\n' "$*"; }
err() { printf '<3>%s\n' "$*"; }

# Another UKI systemd-boot would pick over this one: no counter, or tries left.
fallback() {
  local boot uki
  boot="${BLUEFIN_BOOT_PATH:-$(bootctl --print-boot-path 2>/dev/null || echo /boot)}"
  for uki in "${boot}"/EFI/Linux/*.efi; do
    [ -e "${uki}" ] || continue
    case "${uki##*/}" in
      *+0.efi|*+0-*.efi) ;;
      *) return 0 ;;
    esac
  done
  return 1
}

status="$("${bless}" status 2>/dev/null)" || status=""
case "${status}" in
  indeterminate|bad) ;;
  dirty)
    if ! fallback; then
      warn "boot entry has no tries left and no other UKI to fall back to; not rebooting"
      exit 0
    fi ;;
  *)
    info "boot is ${status:-not boot-counted}; nothing to do"
    exit 0 ;;
esac

if systemctl is-active --quiet boot-complete.target; then
  info "boot-complete.target reached; systemd-bless-boot handles the entry"
  exit 0
fi

version=""
if [ -r "${os_release}" ]; then
  while IFS='=' read -r key value; do
    [ "${key}" = IMAGE_VERSION ] || continue
    value="${value%\"}"; value="${value#\"}"
    version="${value}"
  done < "${os_release}"
fi

failed=()
while read -r unit _; do
  [ -n "${unit}" ] && failed+=("${unit}")
done < <(systemctl list-units --state=failed --plain --no-legend --no-pager 2>/dev/null || true)
if [ "${#failed[@]}" -gt 0 ]; then
  why="failed: ${failed[*]}"
else
  why="no unit failed, but the boot never got there"
fi
msg="Bluefin Server ${version:-(unknown version)} did not reach boot-complete.target before the boot deadline (${why}); its boot entry is ${status}"

for lock in "${locks[@]}"; do
  if [ -e "${lock}" ]; then
    warn "${msg}; ${lock} holds reboots, not rebooting"
    exit 0
  fi
done

for u in kubelet.service k0scontroller.service k0sworker.service; do
  s="$(systemctl is-active "${u}" 2>/dev/null)" || true
  case "${s}" in
    active|activating|deactivating|reloading|refreshing)
      mkdir -p "${sentinel%/*}"
      touch "${sentinel}"
      warn "${msg}; ${u} is ${s}: flagged ${sentinel} for kured to drain and reboot"
      exit 0 ;;
  esac
done

rc=0
"${reboot_lock}" acquire || rc=$?
case "${rc}" in
  0) ;;
  3)
    warn "the FleetLock server could not be reached; the rollback goes ahead without a reboot slot" ;;
  *)
    warn "${msg}; no fleet reboot slot, retrying later"
    exit 75 ;;
esac

err "${msg}; rebooting so systemd-boot falls back after the last try"
exec systemctl --no-block reboot
