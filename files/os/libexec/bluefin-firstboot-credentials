#!/usr/bin/bash
# bluefin-firstboot-credentials — apply the firstboot.* system credentials.
#
# Writes the same files systemd-firstboot(1) would write, in the same format:
#   firstboot.locale, firstboot.locale-messages  -> /etc/locale.conf
#   firstboot.keymap                             -> /etc/vconsole.conf
#   firstboot.timezone                           -> /etc/localtime
# and additionally (systemd <= v259, Flatcar's, has no firstboot.hostname;
# systemd v260 added it as a static hostname applied only when none is set.
# Bluefin applies it unconditionally and also sets the live kernel hostname
# so the first DHCP request carries the name):
#   firstboot.hostname                           -> /etc/hostname + kernel hostname
# from $CREDENTIALS_DIRECTORY, as populated by ImportCredential= in
# bluefin-firstboot-credentials.service. The OS payload is Flatcar's /usr,
# which is built without systemd-firstboot, so the unit cannot call it.
#
# Known differences from systemd-firstboot: trailing newlines in a credential
# are stripped rather than rejected; LC_MESSAGES= is written even when it
# equals LANG=; locales and keymaps are shape-checked, not checked against
# what is installed; timezones must exist under /usr/share/zoneinfo. The
# validators below are at least as strict as systemd's and ASCII-only (systemd
# accepts e.g. spaces and non-ASCII in locales, and '_' in hostnames).
#
# Every value is validated before anything is written; an invalid credential
# fails the whole run and leaves /etc untouched, so the unit fails visibly
# instead of applying a partial configuration.
#
# Deliberately bash builtins plus coreutils only: this runs before sysinit.target.
#
# Usage: bluefin-firstboot-credentials [--root=DIR]
# --root is for tests; the shipped unit passes nothing and writes to /.

set -euo pipefail
# [[:alnum:]] in bash regexes is locale-dependent and PID 1 exports the LANG
# this helper itself writes to locale.conf; systemd's validators are ASCII-only.
export LC_ALL=C

PROG="${0##*/}"
ROOT=""
for arg in "$@"; do
  case "${arg}" in
    --root=*) ROOT="${arg#--root=}"; ROOT="${ROOT%/}" ;;
    *) printf '%s: unknown argument: %s\n' "${PROG}" "${arg}" >&2; exit 2 ;;
  esac
done

log() { printf '%s: %s\n' "${PROG}" "$*" >&2; }
die() { log "$*"; exit 1; }
# die_value MESSAGE VALUE: the value is %q-quoted so a stray CR or other
# control character in a credential shows up in the journal instead of vanishing.
die_value() { die "$1 $(printf '%q' "$2")"; }

[ -n "${CREDENTIALS_DIRECTORY:-}" ] || die "CREDENTIALS_DIRECTORY is not set; run from a unit with ImportCredential=firstboot.*"

[ -d "${CREDENTIALS_DIRECTORY}" ] || die "CREDENTIALS_DIRECTORY ${CREDENTIALS_DIRECTORY} is not a directory"

# Returns the credential content with trailing newlines removed, or nothing
# when the credential is absent or empty. $(<file) silently drops NUL bytes,
# which systemd's read_credential() rejects, so refuse them explicitly.
read_credential() {
  local file="${CREDENTIALS_DIRECTORY}/$1" value
  [ -s "${file}" ] || return 0
  [ "$(tr -d '\0' <"${file}" | wc -c)" -eq "$(wc -c <"${file}")" ] \
    || die "NUL byte in credential $1"
  value="$(<"${file}")"
  printf '%s' "${value}"
}

LOCALE="$(read_credential firstboot.locale)"
LOCALE_MESSAGES="$(read_credential firstboot.locale-messages)"
KEYMAP="$(read_credential firstboot.keymap)"
TIMEZONE="$(read_credential firstboot.timezone)"
HOSTNAME_VALUE="$(read_credential firstboot.hostname)"

# At least as strict as systemd's locale_is_valid(), keymap_is_valid(),
# timezone_is_valid() and hostname_is_valid(); length caps match theirs.
LOCALE_RE='^[[:alnum:]][[:alnum:]_.@+-]*$'
KEYMAP_RE='^[[:alnum:]][[:alnum:]_.-]*$'
TIMEZONE_RE='^[[:alnum:]_+-]+(/[[:alnum:]_+-]+)*$'
HOSTNAME_RE='^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$'

for value in "${LOCALE}" "${LOCALE_MESSAGES}"; do
  if [ -n "${value}" ]; then
    [[ "${value}" =~ ${LOCALE_RE} ]] && [ "${#value}" -lt 128 ] \
      || die_value "invalid locale in credential:" "${value}"
  fi
done
if [ -n "${KEYMAP}" ]; then
  [[ "${KEYMAP}" =~ ${KEYMAP_RE} ]] && [ "${#KEYMAP}" -lt 128 ] \
    || die_value "invalid keymap in credential:" "${KEYMAP}"
fi
if [ -n "${TIMEZONE}" ]; then
  [[ "${TIMEZONE}" =~ ${TIMEZONE_RE} ]] && [ -f "${ROOT}/usr/share/zoneinfo/${TIMEZONE}" ] \
    || die_value "invalid or unknown timezone in credential:" "${TIMEZONE}"
fi
if [ -n "${HOSTNAME_VALUE}" ]; then
  [[ "${HOSTNAME_VALUE}" =~ ${HOSTNAME_RE} ]] && [ "${#HOSTNAME_VALUE}" -le 64 ] \
    || die_value "invalid hostname in credential:" "${HOSTNAME_VALUE}"
fi

umask 022
mkdir -p "${ROOT}/etc"

if [ -n "${LOCALE}" ] || [ -n "${LOCALE_MESSAGES}" ]; then
  {
    [ -n "${LOCALE}" ] && printf 'LANG=%s\n' "${LOCALE}"
    [ -n "${LOCALE_MESSAGES}" ] && printf 'LC_MESSAGES=%s\n' "${LOCALE_MESSAGES}"
  } > "${ROOT}/etc/locale.conf"
  log "wrote /etc/locale.conf"
fi

if [ -n "${KEYMAP}" ]; then
  printf 'KEYMAP=%s\n' "${KEYMAP}" > "${ROOT}/etc/vconsole.conf"
  log "wrote /etc/vconsole.conf"
fi

if [ -n "${TIMEZONE}" ]; then
  ln -sfn "../usr/share/zoneinfo/${TIMEZONE}" "${ROOT}/etc/localtime"
  log "set /etc/localtime -> ${TIMEZONE}"
fi

if [ -n "${HOSTNAME_VALUE}" ]; then
  printf '%s\n' "${HOSTNAME_VALUE}" > "${ROOT}/etc/hostname"
  # PID 1 already applied the image's /etc/hostname before this unit ran, so
  # also set the live kernel hostname for the DHCP request networkd is about
  # to send.
  if [ -z "${ROOT}" ] && [ -w /proc/sys/kernel/hostname ]; then
    printf '%s' "${HOSTNAME_VALUE}" > /proc/sys/kernel/hostname
  fi
  log "set hostname ${HOSTNAME_VALUE}"
fi

# The unit's ExecStartPost stamp gates re-runs; flush the writes above before
# it is created so a power loss cannot leave the stamp without the files.
sync
