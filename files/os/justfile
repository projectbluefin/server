# System-wide justfile for Bluefin Server management

default:
    @just --list

# Enable k0s Kubernetes controller on this host
k8s ROLE="controller" TOKEN="":
    #!/usr/bin/env bash
    set -euo pipefail
    
    # 1. Trigger systemd-sysupdate to pull the k0s systemd-sysext if missing
    if [ ! -f /var/lib/extensions/k0s.raw ]; then
        echo "==> k0s system extension raw image not found in /var/lib/extensions/"
        echo "==> Running systemd-sysupdate to fetch and install the k0s sysext OTA..."
        # Ignore errors if systemd-sysupdate can't connect (e.g. offline dev test)
        systemd-sysupdate update || true
    fi

    # 2. Setup k0s configuration directory
    install -d -m 0755 /etc/k0s

    # 3. Trigger systemd-sysext to merge extensions into /usr immediately
    echo "==> Merging k0s system extension..."
    systemctl enable --now systemd-sysext.service || true
    systemd-sysext merge || true

    # 4. Trigger systemd-tmpfiles to seed declarative manifests
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/k0s-manifests.conf || true

    # 5. Enable and start the selected systemd service
    if [ "{{ROLE}}" = "controller" ] || [ "{{ROLE}}" = "server" ]; then
        echo "==> Enabling and starting k0s controller service..."
        systemctl enable --now k0scontroller.service
    else
        echo "ERROR: Invalid role '{{ROLE}}'. Supported: controller" >&2
        exit 1
    fi

    echo "==> k0s Kubernetes has been successfully configured and started!"
