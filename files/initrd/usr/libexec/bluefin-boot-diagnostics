#!/usr/bin/bash
# bluefin-boot-diagnostics — say on the console why an initrd boot fails.
#
#   check-pull UNIT   Run before UNIT (a systemd-import@.service instance)
#                     downloads the OS image into RAM. HEADs the image URL and
#                     fails with a plain "needs ~X MiB RAM, have Y" message
#                     only when a 2xx answer gives a size that cannot fit. If
#                     it cannot check (no answer, an HTTP error, no
#                     Content-Length), it prints a note and exits 0 so the
#                     download still runs.
#   ignition-kargs    Warn that ignition.* kernel arguments are ignored.
#   failure-summary   ExecStart of emergency.service: print the failed units,
#                     their last log lines and the last errors, then wait
#                     (bluefin.failure_delay, default 60 s) so the reboot that
#                     follows does not scroll them away.
#
# Messages go to every active console (/sys/class/tty/console/active, e.g. the
# monitor and the serial port). /dev/console, where systemd prints its status
# lines, is only the last console= on the kernel command line.
#
# bash builtins, coreutils, curl, systemctl and journalctl only: the initrd
# has no sed or awk.

set -uo pipefail
export LC_ALL=C

PROG="${0##*/}"
DOCS=https://github.com/projectbluefin/server/blob/main/docs/skills/diskless-troubleshooting.md
MEMINFO="${BLUEFIN_DIAG_MEMINFO:-/proc/meminfo}"
CMDLINE="${BLUEFIN_DIAG_CMDLINE:-/proc/cmdline}"
CONSOLES="${BLUEFIN_DIAG_CONSOLES:-/sys/class/tty/console/active}"
DEVDIR="${BLUEFIN_DIAG_DEVDIR:-/dev}"
NETDIR="${BLUEFIN_DIAG_NETDIR:-/sys/class/net}"
# systemd-importd stores machine images under /run/machines in the initrd:
# the /run tmpfs, which systemd caps at 20% of RAM.
PULL_DIR=/run
# Room /run and RAM must keep after the image has landed.
MARGIN_MIB=64
# check_pull's status when the image cannot fit. It differs from bash's own
# error statuses (1, 2, 126, 127, 128+n), so a bug in the check is never
# taken for "does not fit".
TOO_BIG=3
DELAY_NAME=bluefin.failure_delay
DEFAULT_DELAY=60
# The reboot is intentional (unattended retry, boot counting); a floor keeps
# a persistent failure from turning into a hot reboot loop.
MIN_DELAY=10
MAX_DELAY=86400
BAR='=============================================================================='

# log PRIORITY MESSAGE: to the journal (stderr, sd-daemon priority prefix).
log() { printf '<%s>%s: %s\n' "$1" "${PROG}" "$2" >&2; }

# Copy stdin to every active console. A console that blocks must not hold up
# the boot, so each write gets a timeout.
to_consoles() {
  local text c active=console
  text="$(cat)"
  [ -r "${CONSOLES}" ] && active="$(<"${CONSOLES}")"
  for c in ${active}; do
    timeout 5 tee -a "${DEVDIR}/${c}" >/dev/null <<<"${text}" || true
  done
}

# shout PRIORITY LINE...: log every line and print them framed on the consoles.
shout() {
  local pri="$1" line
  shift
  for line in "$@"; do log "${pri}" "${line}"; done
  { printf '\n%s\n' "${BAR}"; printf '%s\n' "$@"; printf '%s\n' "${BAR}"; } | to_consoles
}

mib() { printf '%s' "$(( ($1 + 1048575) / 1048576 ))"; }

meminfo_kib() {
  local key value _
  while read -r key value _; do
    [ "${key}" = "$1:" ] && { printf '%s' "${value}"; return 0; }
  done < "${MEMINFO}"
  return 1
}

# One line per network link: name, operstate, carrier. sysfs only, so it also
# works after emergency.target has stopped systemd-networkd.
links() {
  local dev name state carrier out=()
  for dev in "${NETDIR}"/*; do
    name="${dev##*/}"
    [ -e "${dev}/device" ] || continue
    state="$(<"${dev}/operstate")" 2>/dev/null || state=unknown
    carrier="$(<"${dev}/carrier")" 2>/dev/null || carrier=0
    [ "${carrier}" = 1 ] && carrier=carrier || carrier="no carrier"
    out+=("${name} ${state} (${carrier})")
  done
  if [ "${#out[@]}" -eq 0 ]; then
    printf 'no network interface found (missing NIC driver in the initrd?)\n'
  else
    printf '%s\n' "${out[@]}"
  fi
}

# cannot_check REASON: note on the consoles that the size was not checked. The
# download goes ahead: it may still work (a signed object-store URL can refuse
# HEAD and serve GET), and if it fails the failure summary says why.
cannot_check() {
  local msg="BLUEFIN: cannot check that the OS image fits in RAM ($1); downloading it anyway"
  log 4 "${msg}"
  printf '%s\n' "${msg}" | to_consoles
}

check_pull() {
  local unit="${1:?usage: ${PROG} check-pull <systemd-import@...service>}"
  local desc url out rc status='' len='' line lower
  # systemd-import-generator describes each pull unit as "Download of <URL>";
  # take the URL it resolved (rd.systemd.pull, bootorigin, or the import.pull
  # credential) rather than deriving it a second time.
  desc="$(systemctl show -P Description "${unit}" 2>/dev/null)" || desc=
  url="${desc#Download of }"
  case "${url}" in
    http://*|https://*) ;;
    *) log 6 "${unit}: no http(s) source (${desc:-no description}); nothing to check"; return 0 ;;
  esac

  # Only the size is wanted here; whether the image downloads is for
  # systemd-import to find out.
  out="$(curl -sSIL --retry 3 --retry-delay 2 --connect-timeout 10 --max-time 120 "${url}" 2>&1)"
  rc=$?
  if [ "${rc}" -ne 0 ]; then
    cannot_check "HEAD failed: ${out##*$'\n'}"
    return 0
  fi

  # Headers of every response in the redirect chain; keep the last one.
  while IFS= read -r line; do
    line="${line%$'\r'}"
    lower="${line,,}"
    case "${lower}" in
      http/*) status="${line#* }"; status="${status%% *}"; len= ;;
      content-length:*) len="${line#*:}"; len="${len//[[:space:]]/}" ;;
    esac
  done <<<"${out}"

  case "${status}" in
    2??) ;;
    *) cannot_check "HEAD answered HTTP ${status:-?}"; return 0 ;;
  esac
  if ! [[ "${len}" =~ ^[0-9]+$ ]]; then
    cannot_check "HEAD answered HTTP ${status} with no Content-Length"
    return 0
  fi

  local total_kib avail_kib bavail bsize btotal
  total_kib="$(meminfo_kib MemTotal)" || { cannot_check "no MemTotal in ${MEMINFO}"; return 0; }
  avail_kib="$(meminfo_kib MemAvailable)" || avail_kib="${total_kib}"
  read -r bavail bsize btotal < <(stat -f -c '%a %S %b' "${PULL_DIR}")
  if ! [[ "${bavail:-}${bsize:-}${btotal:-}" =~ ^[0-9]+$ ]] || [ "${btotal}" -eq 0 ] || [ "${total_kib}" -eq 0 ]; then
    cannot_check "cannot read the size of ${PULL_DIR} or of RAM"
    return 0
  fi

  local need=$(( len + MARGIN_MIB * 1048576 ))
  local run_free=$(( bavail * bsize )) run_size=$(( btotal * bsize ))
  local total=$(( total_kib * 1024 )) avail=$(( avail_kib * 1024 ))
  if [ "${need}" -le "${run_free}" ] && [ "${need}" -le "${avail}" ]; then
    log 6 "OS image $(mib "${len}") MiB fits: /run has $(mib "${run_free}") MiB free, MemAvailable $(mib "${avail}") MiB"
    return 0
  fi

  # /run is sized as a fixed share of RAM, so scale what it lacks up to RAM.
  # Work in KiB so the product cannot overflow.
  local used_kib=$(( (run_size - run_free) / 1024 )) need_kib=$(( need / 1024 ))
  local want_run_kib=$(( (used_kib + need_kib) * total_kib / (run_size / 1024) ))
  local want_run=$(( want_run_kib * 1024 ))
  local want_mem=$(( total - avail + need ))
  local want=$(( want_run > want_mem ? want_run : want_mem ))
  # Round up to 64 MiB.
  want=$(( (want + 67108863) / 67108864 * 67108864 ))
  shout 2 "BLUEFIN: NOT ENOUGH RAM FOR A DISKLESS BOOT" \
    "This machine needs ~$(mib "${want}") MiB RAM, have $(mib "${total}") MiB." \
    "The OS image ${url##*/} ($(mib "${len}") MiB) is downloaded into /run, a RAM" \
    "file system capped at $(( run_size * 100 / total ))% of RAM: $(mib "${run_free}") MiB free there, MemAvailable $(mib "${avail}") MiB." \
    "Add RAM or install to disk. ${DOCS}#minimum-ram"
  return "${TOO_BIG}"
}

# Keys of ignition.* kernel arguments (values may carry secrets).
ignition_karg_keys() {
  local -a args
  local arg keys=()
  read -ra args < "${CMDLINE}" || true
  for arg in "${args[@]}"; do
    case "${arg}" in
      ignition.*) keys+=("${arg%%=*}") ;;
    esac
  done
  [ "${#keys[@]}" -gt 0 ] && printf '%s\n' "${keys[*]}"
}

ignition_kargs() {
  local keys
  keys="$(ignition_karg_keys)" || return 0
  shout 4 "BLUEFIN: IGNORED KERNEL ARGUMENTS: ${keys}" \
    "Bluefin Server never reads Ignition settings from the kernel command line." \
    "Pass the config as the ignition.config or ignition.config.url system credential" \
    "(SMBIOS type 11, QEMU fw_cfg, or /loader/credentials/ on the ESP), or serve" \
    "bluefin-node.ign next to the netboot UKI. ${DOCS}#ignition"
}

# What a failed unit most likely means.
hint() {
  local stage
  case "$1" in
    bluefin-pull-check@*)
      echo "the OS image is too big for the RAM of this machine (see the message above)" ;;
    systemd-import@*)
      echo "downloading or verifying the OS image failed: server reachable? SHA256SUMS signed by a key this image trusts? room in /run?" ;;
    systemd-loop@*)
      echo "attaching the OS image as a block device failed (also fails when the download did not happen)" ;;
    systemd-networkd-wait-online.service)
      echo "no network link became routable within 300 s: check the link and that a DHCP server answers" ;;
    systemd-veritysetup@*|sysusr-usr.mount|sysroot-usr.mount)
      echo "/usr could not be verified or mounted: the OS image does not match the usrhash= of this UKI" ;;
    bluefin-ignition-credentials.service)
      echo "staging the Ignition config failed: a refused bluefin-node.ign (the lines below say why) or an invalid ignition.config.url. ${DOCS}#ignition" ;;
    ignition-*.service)
      stage="${1#ignition-}"
      stage="${stage%.service}"
      echo "Ignition stage '${stage}' failed. Every diskless boot runs every stage, so the config must be idempotent. ${DOCS}#ignition" ;;
  esac
}

failure_delay() {
  local value='' arg
  local -a args
  if [ -r "${CREDENTIALS_DIRECTORY:-/nonexistent}/${DELAY_NAME}" ]; then
    value="$(<"${CREDENTIALS_DIRECTORY}/${DELAY_NAME}")"
  fi
  read -ra args < "${CMDLINE}" || true
  for arg in "${args[@]}"; do
    case "${arg}" in "${DELAY_NAME}="*) value="${arg#*=}" ;; esac
  done
  value="${value//[[:space:]]/}"
  [[ "${value}" =~ ^[0-9]{1,6}$ ]] || value="${DEFAULT_DELAY}"
  value=$(( 10#${value} ))
  [ "${value}" -lt "${MIN_DELAY}" ] && value="${MIN_DELAY}"
  [ "${value}" -gt "${MAX_DELAY}" ] && value="${MAX_DELAY}"
  printf '%s' "${value}"
}

indent() { local l; while IFS= read -r l; do printf '%s%s\n' "$1" "${l}"; done; }

failure_summary() {
  local delay unit h keys shown=0
  local -a units matches
  delay="$(failure_delay)"
  mapfile -t units < <(systemctl list-units --state=failed --no-legend --plain --full 2>/dev/null | cut -d' ' -f1)
  {
    printf '\n%s\n' "${BAR}"
    printf 'BLUEFIN: BOOT FAILED\n'
    if [ "${#units[@]}" -eq 0 ]; then
      printf 'No unit failed: a device or job timed out (see the errors below).\n'
    fi
    for unit in "${units[@]}"; do
      [ -n "${unit}" ] || continue
      shown=$(( shown + 1 ))
      [ "${shown}" -le 6 ] || { printf '(%s more failed units)\n' "$(( ${#units[@]} - 6 ))"; break; }
      printf '\nFAILED: %s\n' "${unit}"
      h="$(hint "${unit}")"
      [ -z "${h}" ] || printf '  -> %s\n' "${h}"
      # What the unit's own processes logged (not systemd's lines about it);
      # a download's errors come from systemd-importd.
      matches=("_SYSTEMD_UNIT=${unit}")
      case "${unit}" in systemd-import@*) matches+=(_SYSTEMD_UNIT=systemd-importd.service) ;; esac
      journalctl -b "${matches[@]}" -n 6 -o cat --no-pager 2>/dev/null | indent '  | '
      case "${unit}" in
        systemd-networkd-wait-online.service|systemd-import@*)
          printf '  network links:\n'; links | indent '    ' ;;
      esac
    done
    if keys="$(ignition_karg_keys)"; then
      printf '\nIgnored kernel arguments: %s (use the ignition.config credential instead)\n' "${keys}"
    fi
    printf '\nLast errors (journalctl -b -p err):\n'
    journalctl -b -p err -n 15 -o short-monotonic --no-pager 2>/dev/null | indent '  '
    printf '\nHelp: %s\n' "${DOCS}"
    printf 'Rebooting in %s s (set the %s credential to change the delay).\n' "${delay}" "${DELAY_NAME}"
    printf '%s\n' "${BAR}"
  } | to_consoles
  sleep "${delay}"
}

case "${1:-}" in
  check-pull)
    shift
    # Only "the image cannot fit" fails the unit, and so stops the boot. The
    # check runs in a subshell so that a bug in it (an unset variable, a value
    # it did not expect) lets the download go ahead instead.
    rc=0
    ( check_pull "$@" ) || rc=$?
    [ "${rc}" -ne "${TOO_BIG}" ] || exit 1 ;;
  ignition-kargs) ignition_kargs ;;
  failure-summary) failure_summary ;;
  *) printf 'usage: %s check-pull UNIT | ignition-kargs | failure-summary\n' "${PROG}" >&2; exit 2 ;;
esac
