#!/bin/bash
# Root provisioning entrypoint, not an engine bridge or a sudo target.
[[ $# == 0 ]] || { printf 'usage: bluefin-oci-owner-prepare\n' >&2; exit 1; }
source "${BASH_SOURCE[0]%/*}/bluefin-oci-features"
feature_selection
# The owner is the first regular account (UID 1000-59999), as for the Homebrew
# seed. Without one there is nothing to prepare yet; a later boot retries.
lowest_uid=60000
owner=""
uid=""
while IFS=: read -r acc _ u _ || [[ -n "$acc" ]]; do
    if [[ $u =~ ^[0-9]+$ ]] && (( u >= 1000 && u < lowest_uid )); then
        lowest_uid=$u
        owner="$acc"
        uid="$u"
    fi
done < <(getent passwd)
[[ -n $owner ]] || { printf '%s: no regular account yet, nothing to prepare\n' "${0##*/}" >&2; exit 0; }
[[ $owner =~ ^[a-zA-Z_][a-zA-Z0-9_.-]*[$]?$ ]] || fail 'invalid owner account name'

if [[ $podman == true || $docker == true ]]; then
    [[ -f /sys/fs/cgroup/cgroup.controllers ]] || fail 'rootless runtimes require cgroup v2'
    [[ ! -f /proc/sys/user/max_user_namespaces || $(cat /proc/sys/user/max_user_namespaces) != 0 ]] || fail 'unprivileged user namespaces are disabled'
    [[ ! -f /proc/sys/kernel/unprivileged_userns_clone || $(cat /proc/sys/kernel/unprivileged_userns_clone) == 1 ]] || fail 'unprivileged user namespaces are disabled'
    # These FSDK shadow helpers authorize only the caller's subordinate ranges.
    # No broad sudo/systemd-run permission and no host Docker group are needed.
    for helper in newuidmap newgidmap; do
        [[ -x /usr/bin/$helper && $(stat -c %u /usr/bin/$helper) == 0 ]] || fail "$helper must be a root-owned FSDK executable in the host image"
    done
    install -d -m0755 /run/lock
    exec 9>/run/lock/bluefin-rootless-subids.lock
    flock -x 9
    for map in /etc/subuid /etc/subgid; do
        [[ ! -L "$map" ]] || fail "$map must not be a symlink"
        [[ -e "$map" ]] || install -m0644 /dev/null "$map"
        [[ $(stat -c %u "$map") == 0 ]] || fail "$map must be root-owned"
        mode=$(stat -c %a "$map")
        (( (8#$mode & 0022) == 0 )) || fail "$map must not be group/world writable"
        next=100000
        found=false
        lookup=passwd
        [[ $map != /etc/subgid ]] || lookup=group
        account_ids=()
        while IFS=: read -r _ _ account_id _; do
            [[ $account_id =~ ^[0-9]+$ ]] || fail "invalid $lookup account ID"
            account_id=$((10#$account_id))
            account_ids+=("$account_id")
            (( account_id < next )) || next=$((account_id + 1))
        done < <(getent "$lookup")
        while IFS=: read -r name start count extra || [[ -n "$name" ]]; do
            [[ -z "$name" || $name == \#* ]] && continue
            [[ $start =~ ^[0-9]+$ && $count =~ ^[0-9]+$ && -z ${extra:-} ]] || fail "malformed $map entry"
            start=$((10#$start)); count=$((10#$count))
            (( start > 0 && count > 0 && start + count <= 4294967295 )) || fail "invalid $map range"
            for account_id in "${account_ids[@]}"; do
                (( account_id < start || account_id >= start + count )) || fail "$map subordinate range overlaps an existing $lookup ID"
            done
            (( start + count <= next )) || next=$((start + count))
            if [[ $name == "$owner" || $name == "$uid" ]]; then
                (( count >= 65536 )) || fail "$owner needs at least 65536 subordinate IDs in $map"
                found=true
                owner_start=$start
                owner_end=$((start + count))
            fi
        done < "$map"
        if [[ $found == false ]]; then
            (( next + 65536 <= 4294967295 )) || fail "no subordinate ID space in $map"
            printf '\n%s:%s:65536\n' "$owner" "$next" >> "$map"
        fi
        if [[ $found == true ]]; then
            while IFS=: read -r name start count _; do
                [[ -z "$name" || $name == \#* || $name == "$owner" || $name == "$uid" ]] && continue
                start=$((10#$start)); count=$((10#$count))
                (( start >= owner_end || start + count <= owner_start )) || fail "$map owner range overlaps another identity"
            done < "$map"
        fi
    done
    flock -u 9
    loginctl enable-linger "$owner"
    systemctl start "user@$uid.service"
fi

if [[ $podman == true ]]; then
    [[ -x /usr/lib/bluefin/podman/podman ]] || fail 'selected Podman sysext is not merged'
    # C entries populate absent targets, never replace operator configuration.
    systemd-tmpfiles --create /usr/lib/bluefin/podman/tmpfiles.conf
fi
if [[ $docker == true ]]; then
    [[ -x /usr/lib/bluefin/docker/bin/dockerd ]] || fail 'selected Docker sysext is not merged'
fi
if systemctl is-active --quiet "user@$uid.service"; then
    systemctl --user --machine="$owner@.host" daemon-reload
    for engine in podman docker; do
        unit=bluefin-docker.service
        [[ $engine != podman ]] || unit=bluefin-podman.socket
        if [[ ${!engine} == true ]]; then
            systemctl --user --machine="$owner@.host" enable --now "$unit"
        elif systemctl --user --machine="$owner@.host" cat "$unit" >/dev/null 2>&1; then
            systemctl --user --machine="$owner@.host" disable --now "$unit"
            [[ $engine != podman ]] || systemctl --user --machine="$owner@.host" stop bluefin-podman.service
        fi
    done
fi
