[Unit]
Description=Prepare the first regular user's rootless host OCI engines
After=bluefin-sysext-fetch.service bluefin-oci-features.service
Wants=bluefin-sysext-fetch.service

[Service]
Type=oneshot
ImportCredential=bluefin.homebrew.profile
ImportCredential=bluefin.homebrew.podman
ImportCredential=bluefin.homebrew.docker
ExecStart=/usr/libexec/bluefin-oci-owner-prepare
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
