# Bluefin Home Server: the base image's Homebrew (seeded at first boot, see
# docs/skills/homebrew-seed.md) plus a default rootless Podman engine.
# The first boot asks for the root password as on any node; accounts, passwords and keys are
# provisioned privately through credentials, never from this template.
# Optional host engines and the existing Homelab/KubeStellar profile use
# bluefin.homebrew.{podman,docker,cluster} boolean credentials. The defaults
# below also cover template-only netboot; explicit selections win.
# Podman defaults on; Docker, the cluster and full federation stay off.
variant: fcos
version: 1.7.0
systemd:
  units:
    - name: bluefin-sysext-fetch.service
      enabled: true
      dropins:
        - name: 45-home-server-runtimes.conf
          contents: |
            [Unit]
            Requires=bluefin-oci-features.service
            After=bluefin-oci-features.service
    - name: bluefin-oci-features.service
      dropins:
        - name: 40-home-server.conf
          contents: |
            [Service]
            SetCredential=bluefin.homebrew.profile:home-server
    - name: bluefin-oci-owner-prepare.service
      enabled: true
      dropins:
        - name: 40-home-server.conf
          contents: |
            [Service]
            SetCredential=bluefin.homebrew.profile:home-server
storage:
  files:
    - path: /etc/sysupdate.d/nspawn-org.feature.d/50-home-server.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Feature]
          Enabled=true
