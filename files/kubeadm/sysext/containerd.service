# Upstream containerd's containerd.service (version: include/kubeadm.yml),
# adapted to a sysext: binaries in /usr/bin, and host setup that must hold
# after the sysext is merged (systemd-sysext.service is not ordered against
# systemd-tmpfiles-setup, systemd-modules-load or systemd-sysctl, so their
# boot-time runs may not see this extension's drop-ins).
[Unit]
Description=containerd container runtime
Documentation=https://containerd.io
After=network.target dbus.service systemd-sysext.service
RequiresMountsFor=/var/lib/containerd

[Service]
# Seed a writable /etc/containerd/config.toml (and /etc/crictl.yaml) from
# /usr/share/bluefin only if absent; a cluster DaemonSet may edit it in place.
ExecStartPre=/usr/bin/systemd-tmpfiles --create kubeadm.conf
# Idempotent: prepends the imports glob at the top of the file (the only
# always-valid top level placement) when the on-disk config lacks it (an
# installed node from before `imports` existed keeps its seeded copy until
# this runs; docs/skills/kubeadm-sysext.md, review backlog issue #351).
# Best effort (`-`): a config the helper cannot write (immutable, read-only
# /etc) must not stop containerd from starting with its existing config.
ExecStartPre=-/usr/libexec/bluefin-kubeadm-containerd-migrate
ExecStartPre=/usr/bin/modprobe overlay
ExecStartPre=/usr/bin/modprobe br_netfilter
ExecStartPre=/usr/lib/systemd/systemd-sysctl 90-kubeadm.conf
ExecStart=/usr/bin/containerd

Type=notify
Delegate=yes
KillMode=process
Restart=always
RestartSec=5

# Having non-zero Limit*s causes performance problems due to accounting overhead
# in the kernel. We recommend using cgroups to do container-local accounting.
LimitNPROC=infinity
LimitCORE=infinity

TasksMax=infinity
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
